generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GroupStatus {
  COLLECTING
  BUDGET_NEGOTIATION
  PLANNING
  COMPLETE
}

enum PreferenceStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum ChatRole {
  USER
  ASSISTANT
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Group {
  id            String      @id @default(cuid())
  name          String
  groupCode     String      @unique
  passwordHash  String
  destination   String?
  adminMemberId String?
  status        GroupStatus @default(COLLECTING)
  lockedBudget  Decimal?    @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  members     Member[]
  itineraries Itinerary[]

  @@index([groupCode])
}

model Member {
  id               String           @id @default(cuid())
  groupId          String
  name             String
  isAdmin          Boolean          @default(false)
  preferenceStatus PreferenceStatus @default(PENDING)
  privateBudget    Decimal?         @db.Decimal(12, 2)
  joinedAt         DateTime         @default(now())

  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  preferenceProfile PreferenceProfile?
  chatMessages      ChatMessage[]

  @@index([groupId])
}

model PreferenceProfile {
  id       String @id @default(cuid())
  memberId String @unique

  scores     Json
  priorities Json

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  memberId  String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

model Itinerary {
  id      String @id @default(cuid())
  groupId String
  version Int    @default(1)

  dayPlans           Json
  budgetBreakdown    Json
  satisfactionScores Json
  tradeoffReport     String

  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, version])
  @@index([groupId])
}
