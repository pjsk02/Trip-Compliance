# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://tripsync:tripsync@localhost:5432/tripsync"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
# Model used for preference chat + extraction. Haiku is fast and cheap for chat; swap for Sonnet for better extraction quality.
CLAUDE_MODEL="claude-haiku-4-5-20251001"

# Backend
PORT=3001
NODE_ENV=development

# JWT — generate a strong random secret for production: `openssl rand -hex 32`
JWT_SECRET="change-me-before-deploying"

# Frontend (Vite exposes vars prefixed with VITE_)
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:5173 to Authorised JavaScript Origins
# 4. No redirect URI needed (we use the frontend-token / credential approach)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Expose the client ID to Vite so the frontend can initialise GoogleOAuthProvider
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
