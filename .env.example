# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://tripsync:tripsync@localhost:5432/tripsync"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Backend
PORT=3001
NODE_ENV=development

# JWT — generate a strong random secret for production: `openssl rand -hex 32`
JWT_SECRET="change-me-before-deploying"

# Frontend (Vite exposes vars prefixed with VITE_)
VITE_API_URL=http://localhost:3001
